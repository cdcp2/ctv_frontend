---
import Layout from '../layouts/Layout.astro';
import {
  getAds,
  getBreaking,
  getFeatured,
  getMostRead,
  getSiteConfig,
  getVideos,
  listArticles,
  type Advertisement,
  type Tag,
} from '../lib/api';
import { inferStreamSource, resolveMediaUrl, resolveVideoEmbedUrl } from '../lib/media';
import AdSlot from '../components/AdSlot.astro';
import ManualAdSlot from '../components/ManualAdSlot.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE || 'http://localhost:3000';
const adRefreshMsRaw = Number.parseInt(import.meta.env.PUBLIC_AD_ROTATION_REFRESH_MS || '30000', 10);
const adRefreshMs = Number.isFinite(adRefreshMsRaw) && adRefreshMsRaw > 0 ? adRefreshMsRaw : 30000;
const adRotationSeconds = Math.max(5, Math.round(adRefreshMs / 1000));

const [siteConfig, featured, breaking, videos, mostRead, latest, tags] = await Promise.all([
  getSiteConfig(),
  getFeatured(),
  getBreaking(),
  getVideos(),
  getMostRead(),
  listArticles({}), // últimas
  fetch(`${apiBase}/api/tags`).then(r => r.ok ? r.json() : null).catch(() => null) as Promise<Tag[] | null>,
]);

const [adsHomeTop, adsSidebar] = await Promise.all([
  getAds('home_top', { limit: 1, rotate: true, rotationIntervalSeconds: adRotationSeconds }),
  getAds('home_sidebar', {
    limit: 1,
    rotate: true,
    rotationIntervalSeconds: adRotationSeconds,
    fallbackPositions: ['sidebar'],
  }),
]);

const featuredList = (featured && featured.length ? featured : (breaking || [])).slice(0, 5);
const latestList = latest?.slice(0, 8) ?? [];
const videoCandidates = videos && videos.length ? videos : (latest ?? []).filter(item => !!item.video_embed_url);
const videoList = videoCandidates.slice(0, 6);
const mostReadList = mostRead?.slice(0, 6) ?? [];
const tagList = tags ?? [];
const initialTagLimit = 10;
const tagChunkSize = 8;

const resolveMedia = (url?: string | null) => resolveMediaUrl(url, apiBase);
const latestVideo = videoList.find((item) => !!resolveVideoEmbedUrl(item.video_embed_url)) || null;
const latestVideoEmbed = resolveVideoEmbedUrl(latestVideo?.video_embed_url);
const activeLive = siteConfig?.is_live_active ? inferStreamSource(siteConfig?.live_stream_url) : null;
const featuredVideo = activeLive
  ? {
      ...activeLive,
      badge: activeLive.kind === 'hls' ? 'En vivo' : 'Señal activa',
      summary: 'Sigue la transmisión en curso.',
      articleHref: null,
      articleTitle: null,
    }
  : latestVideo && latestVideoEmbed
  ? {
      kind: 'embed' as const,
      url: latestVideoEmbed,
      badge: 'Último video',
      summary: 'Mira el video más reciente disponible.',
      articleHref: `/article/${latestVideo.slug}`,
      articleTitle: latestVideo.title,
    }
  : null;
const featureHeading = activeLive ? 'Señal en vivo' : featuredVideo ? 'Último video' : 'Video principal';
const featureSummary = featuredVideo?.summary || '';
const shouldFetchYouTubeFallback = !activeLive && !featuredVideo;

const adsClient = 'ca-pub-7829004963088413';
const homeTopAdSlot = import.meta.env.PUBLIC_ADS_SLOT_HOME_TOP || '';
const homeSideAdSlot =
  import.meta.env.PUBLIC_ADS_SLOT_HOME_SIDEBAR ||
  import.meta.env.PUBLIC_ADS_SLOT_HOME_SIDE ||
  '';

const manualHomeTop = adsHomeTop?.[0] as Advertisement | undefined;
const manualSidebar = adsSidebar?.[0] as Advertisement | undefined;
---

<Layout title="Inicio">
  <section class="grid lg:grid-cols-[2fr,1fr] gap-8 items-start">
    <div class="space-y-8">
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 pt-4 flex items-start justify-between gap-3">
          <div class="space-y-1">
            <h2 id="home-feature-title" class="text-lg font-black uppercase text-ctv-accent">
              {featureHeading}
            </h2>
            <p
              id="home-feature-summary"
              class:list={[
                'text-sm text-slate-600',
                !featureSummary && 'hidden',
              ]}
            >
              {featureSummary}
            </p>
          </div>
          <span
            id="home-feature-badge"
            class:list={[
              'inline-flex items-center rounded-full bg-ctv-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-ctv-primary',
              !featuredVideo?.badge && 'hidden',
            ]}
          >
            {featuredVideo?.badge || ''}
          </span>
        </div>
        <div id="home-feature-player" class="aspect-video bg-ctv-dark/5">
          {featuredVideo?.kind === 'file' ? (
            <video
              src={featuredVideo.url}
              class="w-full h-full"
              controls
              autoplay
              muted
              playsinline
              preload="none"
            ></video>
          ) : featuredVideo?.kind === 'hls' ? (
            <div class="w-full h-full relative">
              <video
                id="home-live-video"
                class="w-full h-full"
                controls
                autoplay
                muted
                playsinline
                preload="none"
              ></video>
            </div>
          ) : featuredVideo?.kind === 'embed' ? (
            <iframe
              src={featuredVideo.url}
              class="w-full h-full"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="Video principal"
            ></iframe>
          ) : (
            <div class="flex h-full flex-col items-center justify-center gap-2 bg-slate-100 px-6 text-center text-slate-600">
              <strong class="text-base font-black uppercase text-slate-800">Video no disponible</strong>
              <span>En este momento no hay contenido en video para mostrar.</span>
            </div>
          )}
        </div>
        {featuredVideo?.articleHref && featuredVideo.articleTitle ? (
          <div id="home-feature-source" class="px-4 pt-3 text-sm text-slate-600">
            Tomado del artículo{' '}
            <a href={featuredVideo.articleHref} class="font-semibold text-ctv-accent hover:underline">
              {featuredVideo.articleTitle}
            </a>
          </div>
        ) : (
          <div id="home-feature-source" class="hidden px-4 pt-3 text-sm text-slate-600"></div>
        )}

        <div class="p-4">
          {manualHomeTop ? (
            <ManualAdSlot
              ad={manualHomeTop}
              position="home_top"
              apiBase={apiBase}
              refreshMs={adRefreshMs}
            />
          ) : homeTopAdSlot ? (
            <AdSlot client={adsClient} slot={homeTopAdSlot} slotType="home_top" />
          ) : (
            <ManualAdSlot
              position="home_top"
              apiBase={apiBase}
              refreshMs={adRefreshMs}
            />
          )}
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-black text-ctv-primary uppercase">Últimas noticias</h3>
          <a href="/" class="text-sm text-ctv-accent font-semibold">Ver todas</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-latest-list>
          {latestList.length === 0 && <p class="text-sm text-gray-500">No hay noticias aún.</p>}
          {latestList.map((item) => (
            <a href={`/article/${item.slug}`} class="bg-white shadow-sm border border-gray-100 rounded-lg overflow-hidden hover:-translate-y-1 transition transform">
              {resolveMedia(item.main_image_url) && <img src={resolveMedia(item.main_image_url)!} alt={item.title} class="w-full h-36 object-cover" loading="lazy" />}
              <div class="p-4 space-y-2">
                <p class="text-xs uppercase tracking-wide text-ctv-accent font-bold">Noticia</p>
                <h4 class="font-bold leading-tight line-clamp-2">{item.title}</h4>
                {item.excerpt && <p class="text-sm text-gray-600 line-clamp-2">{item.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <aside class="bg-white shadow rounded-lg p-4">
        <h3 class="text-2xl font-black text-ctv-accent mb-4 uppercase">Destacado</h3>
        <div class="space-y-4">
          {featuredList.length === 0 && <p class="text-sm text-gray-500">Aún no hay destacados.</p>}
          {featuredList.map((item, idx) => (
            <a href={`/article/${item.slug}`} class="flex gap-3 p-3 hover:bg-gray-50 rounded transition">
              <span class="text-ctv-accent font-black text-xl">{idx + 1}</span>
              <div>
                <p class="font-bold leading-tight">{item.title}</p>
                {item.excerpt && <p class="text-sm text-gray-600 mt-1 line-clamp-2">{item.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      </aside>

      <div class="bg-white shadow rounded-lg p-4">
        <h3 class="text-xl font-black text-ctv-primary uppercase mb-3">Publicidad</h3>
        {manualSidebar ? (
          <ManualAdSlot
            ad={manualSidebar}
            position="home_sidebar"
            apiBase={apiBase}
            fallbackPositions={['sidebar']}
            showLabel={false}
            refreshMs={adRefreshMs}
          />
        ) : homeSideAdSlot ? (
          <AdSlot
            client={adsClient}
            slot={homeSideAdSlot}
            slotType="home_sidebar"
            showLabel={false}
          />
        ) : (
          <ManualAdSlot
            position="home_sidebar"
            apiBase={apiBase}
            fallbackPositions={['sidebar']}
            showLabel={false}
            refreshMs={adRefreshMs}
          />
        )}
      </div>

      <div class="bg-white shadow rounded-lg p-4">
        <h3 class="text-xl font-black text-ctv-primary uppercase mb-3">Tags</h3>
        <div id="tag-list" class="flex flex-wrap gap-2" data-initial={initialTagLimit} data-chunk={tagChunkSize}>
          {tagList.length === 0 && <p class="text-sm text-gray-500">Sin tags aún.</p>}
          {tagList.map((tag, idx) => (
            <a
              href={`/tag/${tag.slug}`}
              class={`text-xs bg-ctv-primary/10 text-ctv-primary px-2 py-1 rounded-full hover:bg-ctv-primary/20 transition ${idx >= initialTagLimit ? 'hidden' : ''}`}
              data-idx={idx}
            >
              #{tag.name}
            </a>
          ))}
        </div>
        {tagList.length > initialTagLimit && (
          <button id="tag-more" class="mt-3 text-sm font-semibold text-ctv-accent hover:underline" data-state="collapsed">
            Ver más
          </button>
        )}
      </div>

      <div class="bg-white shadow rounded-lg p-4">
        <h3 class="text-xl font-black text-ctv-primary uppercase mb-3">Más leídas</h3>
        <div class="space-y-3" data-mostread-list>
          {mostReadList.length === 0 && <p class="text-sm text-gray-500">Sin datos aún.</p>}
          {mostReadList.map((item) => (
            <a href={`/article/${item.slug}`} class="block hover:text-ctv-accent transition">
              <p class="font-semibold leading-tight">{item.title}</p>
            </a>
          ))}
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-4">
        <h3 class="text-xl font-black text-ctv-primary uppercase mb-3">Videos</h3>
        <div class="space-y-3">
          {videoList.length === 0 && <p class="text-sm text-gray-500">Sin videos aún.</p>}
          {videoList.map((item) => (
            <a href={`/article/${item.slug}`} class="flex gap-3 items-center hover:bg-gray-50 p-2 rounded transition">
              {resolveMedia(item.main_image_url) && <img src={resolveMedia(item.main_image_url)!} alt={item.title} class="w-16 h-12 object-cover rounded" loading="lazy" />}
              <div>
                <p class="text-xs uppercase text-ctv-accent font-bold">Video</p>
                <p class="font-semibold leading-tight line-clamp-2">{item.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const list = document.getElementById('tag-list');
      const btn = document.getElementById('tag-more');
      if (!list || !btn) return;
      const initial = Number(list.dataset.initial || '10');
      const chunk = Number(list.dataset.chunk || '8');
      const items = Array.from(list.querySelectorAll('[data-idx]'));
      let shown = initial;

      const render = () => {
        items.forEach((el) => {
          const idx = Number(el.getAttribute('data-idx') || '0');
          if (idx < shown) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        if (shown >= items.length) {
          btn.textContent = 'Ver menos';
          btn.dataset.state = 'expanded';
        } else {
          btn.textContent = 'Ver más';
          btn.dataset.state = 'collapsed';
        }
      };

      btn.addEventListener('click', () => {
        if (btn.dataset.state === 'collapsed') {
          shown = Math.min(items.length, shown + chunk);
        } else {
          shown = initial;
        }
        render();
      });

      render();
    });
  </script>

  {featuredVideo?.kind === 'hls' ? (
    <script is:inline data-hls-url={featuredVideo.url}>
      (() => {
        const script = document.currentScript;
        const url = script?.dataset.hlsUrl || '';
        const video = document.getElementById('home-live-video');
        if (!url || !video) return;

        const attach = () => {
          if (video.canPlayType('application/vnd.apple.mpegurl')) {
            video.src = url;
            video.play().catch(() => {});
            return;
          }
          if (!window.Hls) return;
          const hls = new window.Hls();
          hls.loadSource(url);
          hls.attachMedia(video);
        };

        if (!window.Hls && !video.canPlayType('application/vnd.apple.mpegurl')) {
          const loader = document.createElement('script');
          loader.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5.11/dist/hls.min.js';
          loader.onload = attach;
          document.head.appendChild(loader);
          return;
        }

        attach();
      })();
    </script>
  ) : null}

  {shouldFetchYouTubeFallback ? (
    <script is:inline data-endpoint="/api/youtube/latest">
      (() => {
        const script = document.currentScript;
        const endpoint = script?.dataset.endpoint || '/api/youtube/latest';
        const player = document.getElementById('home-feature-player');
        const title = document.getElementById('home-feature-title');
        const summary = document.getElementById('home-feature-summary');
        const badge = document.getElementById('home-feature-badge');
        const source = document.getElementById('home-feature-source');
        if (!player) return;

        fetch(endpoint)
          .then((res) => (res.ok ? res.json() : null))
          .then((payload) => {
            const video = payload?.video;
            if (!video?.embedUrl) return;

            const iframe = document.createElement('iframe');
            iframe.src = video.embedUrl;
            iframe.className = 'w-full h-full';
            iframe.allow = 'autoplay; encrypted-media';
            iframe.allowFullscreen = true;
            iframe.title = video.title || 'Video principal';
            player.replaceChildren(iframe);

            if (title) title.textContent = 'Ultimo video';
            if (summary) {
              summary.textContent = 'Mira el video mas reciente disponible.';
              summary.classList.remove('hidden');
            }
            if (badge) {
              badge.textContent = 'Video';
              badge.classList.remove('hidden');
            }
            if (source && video.watchUrl) {
              source.textContent = '';
              const link = document.createElement('a');
              link.href = video.watchUrl;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.className = 'font-semibold text-ctv-accent hover:underline';
              link.textContent = video.title || 'Ver video';
              source.append('Tomado de ', link);
              source.classList.remove('hidden');
            }
          })
          .catch(() => {});
      })();
    </script>
  ) : null}
</Layout>
